# Solo desarrollo local. Reemplazar todos los valores antes de ejecutar.
APP_NAME=XIL-AC
APP_ENV=development
LOG_LEVEL=INFO
TRACE_ENABLED=true
RISK_GATE_ENABLED=true
HUMAN_OVERRIDE_ENABLED=true
# Límite compartido de búsquedas por identidad y ventana fija.
RESEARCH_RATE_LIMIT_REQUESTS=30
RESEARCH_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_RETENTION_DAYS=2
# Bloqueado por defecto; no habilitar en esta etapa.
CFE_SESSION_PROCESSING_ENABLED=false
XILAC_API_TOKEN=REEMPLAZAR_POR_UN_TOKEN_ALEATORIO_LARGO
DATABASE_URL=
POSTGRES_DB=xilac
POSTGRES_USER=xilac_app
POSTGRES_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_LARGA
# Solo staging/producción con proveedor OIDC real:
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles

# Motor de investigación: brave (requiere clave) o searxng (instancia propia).
RESEARCH_BACKEND=brave
SEARXNG_BASE_URL=http://searxng:8080
# Solo para el despliegue opcional compose.selfhosted-search.yaml.
# Generar una clave larga y aleatoria; nunca subir el valor real.
SEARXNG_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
# Proveedor de búsqueda comercial opcional; dejar vacío si se usa SearXNG.
BRAVE_SEARCH_API_KEY=
